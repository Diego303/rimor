---
import '../ui/tema/fuentes';
import '../ui/tema/estilos.css';

interface Props {
  titulo?: string;
}
const { titulo = 'Rimor' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Rimor: del rumor a la conclusión." />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
    <!-- Aplica el tema forzado antes de pintar, sin parpadeo (src/ui/tema/tema.ts). -->
    <script is:inline>
      try {
        var t = localStorage.getItem('rimor:tema');
        if (t === 'claro') document.documentElement.dataset.theme = 'light';
        else if (t === 'oscuro') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
