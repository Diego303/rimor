{
  "name": "rimor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rimor: del rumor a la conclusión. App web local y privada para técnicos e investigadores.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && pnpm -r --filter \"./paquetes/*\" typecheck",
    "lint": "biome check . && node scripts/comprobar-colores.mjs && node scripts/comprobar-textos.mjs",
    "lint:arreglar": "biome check --write .",
    "test": "vitest run",
    "tamano": "node scripts/tamano-carga.mjs",
    "verificar": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm tamano && pnpm comprobar:dist",
    "marca": "node scripts/marca.mjs",
    "comprobar:dist": "node scripts/comprobar-dist.mjs"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "astro": "^5.17.1",
    "comlink": "^4.4.2",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "~0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@rimor/estadistica": "workspace:*",
    "@rimor/formato": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.3",
    "opentype.js": "^2.0.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
