{
  "name": "rimor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rimor: del rumor a la conclusión. App web local y privada para técnicos e investigadores.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && pnpm -r --filter \"./paquetes/*\" typecheck",
    "lint": "biome check . && node scripts/comprobar-colores.mjs && node scripts/comprobar-textos.mjs",
    "lint:arreglar": "biome check --write .",
    "test": "vitest run",
    "tamano": "node scripts/tamano-carga.mjs",
    "deteccion": "node scripts/deteccion.mjs",
    "verificar": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm tamano && pnpm comprobar:dist",
    "marca": "node scripts/marca.mjs",
    "comprobar:dist": "node scripts/comprobar-dist.mjs"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@lezer/common": "1.5.3",
    "@lezer/cpp": "1.1.6",
    "@lezer/go": "1.0.1",
    "@lezer/highlight": "1.2.5",
    "@lezer/java": "1.1.4",
    "@lezer/javascript": "1.5.6",
    "@lezer/php": "1.0.6",
    "@lezer/python": "1.1.19",
    "@lezer/rust": "1.0.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "3.14.13",
    "astro": "^5.17.1",
    "comlink": "^4.4.2",
    "fflate": "0.8.3",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "idb": "^8.0.4",
    "minisearch": "7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "~0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@rimor/estadistica": "workspace:*",
    "@rimor/formato": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.3",
    "opentype.js": "^2.0.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
